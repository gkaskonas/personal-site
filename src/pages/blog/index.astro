---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection } from "astro:content";
import BlogCardModern from "@/components/BlogCardModern.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// First post is featured
const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);
---

<BlogLayout
  title="Blog | Peter Kaskonas"
  description="Peter Kaskonas' blog on AWS, DevOps, cloud architecture and modern web development."
  canonical="https://peterkaskonas.com/blog"
>
  <h1 class="text-[clamp(2.75rem,7vw,5rem)] font-extrabold leading-[0.95] tracking-[-0.04em]">
    Notes from building on AWS
  </h1>
  <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
    Write-ups on cloud architecture, DevOps and web development, from real projects.
  </p>

  {
    sortedPosts.length === 0 ? (
      <p class="mt-16 text-lg text-muted-foreground">
        No articles published yet. Follow me on
        <a class="text-primary underline" href="https://www.linkedin.com/in/giedrius-k-7a2880a5/">LinkedIn</a>
        to hear when the first one goes up.
      </p>
    ) : (
      <div class="mt-16 space-y-20">
        {featuredPost && <BlogCardModern post={featuredPost} featured />}
        {remainingPosts.length > 0 && (
          <section aria-labelledby="more">
            <h2 id="more" class="border-t pt-6 text-xl font-bold">More articles</h2>
            <div class="mt-8 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
              {remainingPosts.map((post) => (
                <BlogCardModern post={post} />
              ))}
            </div>
          </section>
        )}
      </div>
    )
  }
</BlogLayout>
