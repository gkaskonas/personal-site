---
// Hero: type does the talking; the Suffolk horizon underneath is the page's signature.
const words = ["Websites","and","software","for","Suffolk","businesses."];
---

<section class="relative overflow-hidden">
  <div class="container-page pb-10 pt-16 sm:pt-24 lg:pt-28">
    <p class="hero-fade mb-6 text-base font-medium text-muted-foreground sm:text-lg" style="--d: 0s">
      Peter Kaskonas, software engineer in Suffolk
    </p>
    <h1
      class="max-w-[14ch] text-[clamp(2.9rem,8vw,6.5rem)] font-extrabold leading-[0.92] tracking-[-0.045em]"
    >
      {
        words.map((w, i) => (
          <>
            <span class="word">
              <span style={`--i: ${i}`}>{w}</span>
            </span>{" "}
          </>
        ))
      }
    </h1>
    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,34rem)_1fr] lg:items-end">
      <p class="hero-fade text-lg text-muted-foreground sm:text-xl" style="--d: 0.65s">
        I build fast websites, booking systems and custom web apps for local businesses, built on the
        same AWS foundations I have used at Ocado and Lumar.
      </p>
      <div class="hero-fade flex flex-wrap items-center gap-x-6 gap-y-3 lg:justify-end" style="--d: 0.8s">
        <a href="#contact" class="btn-primary">Start a project</a>
        <a href="#work" class="ink-link">See recent work</a>
      </div>
    </div>
  </div>

  <!-- Big sky, drifting clouds, birds, a flint church tower and a low sun over the fields -->
  <svg
    aria-hidden="true"
    class="block h-[clamp(160px,24vw,320px)] w-full"
    viewBox="0 0 1440 300"
    preserveAspectRatio="xMidYMax slice"
  >
    <defs>
      <clipPath id="sky"><rect width="1440" height="170" /></clipPath>
      <radialGradient id="glow">
        <stop offset="55%" stop-color="hsl(var(--accent))" stop-opacity="0.45" />
        <stop offset="100%" stop-color="hsl(var(--accent))" stop-opacity="0" />
      </radialGradient>
      <path id="cloud" d="M0 34a18 18 0 0 1 24-17 26 26 0 0 1 48-4 20 20 0 0 1 34 12 14 14 0 0 1 6 27H8A12 12 0 0 1 0 34Z" />
    </defs>

    <g class="stars" fill="hsl(var(--foreground))">
      <circle class="star" cx="140" cy="40" r="2" style="--t: 3s; --delay: -0.0s" />
      <circle class="star" cx="260" cy="90" r="1.4" style="--t: 4s; --delay: -0.7s" />
      <circle class="star" cx="410" cy="24" r="1.4" style="--t: 5s; --delay: -1.4s" />
      <circle class="star" cx="620" cy="60" r="2" style="--t: 6s; --delay: -2.1s" />
      <circle class="star" cx="760" cy="18" r="1.4" style="--t: 3s; --delay: -2.8s" />
      <circle class="star" cx="880" cy="96" r="1.4" style="--t: 4s; --delay: -3.5s" />
      <circle class="star" cx="1000" cy="40" r="2" style="--t: 5s; --delay: -4.2s" />
      <circle class="star" cx="1240" cy="28" r="1.4" style="--t: 6s; --delay: -4.9s" />
      <circle class="star" cx="1340" cy="84" r="1.4" style="--t: 3s; --delay: -5.6s" />
      <circle class="star" cx="1180" cy="110" r="2" style="--t: 4s; --delay: -6.3s" />
      <circle class="star" cx="540" cy="120" r="1.4" style="--t: 5s; --delay: -7.0s" />
      <circle class="star" cx="60" cy="110" r="1.4" style="--t: 6s; --delay: -7.7s" />
    </g>

    <g fill="hsl(var(--cloud))">
      <use href="#cloud" class="cloud" x="0" y="30" style="--t: 110s; --delay: -40s" />
      <use href="#cloud" class="cloud" x="0" y="70" transform="scale(0.7)" style="--t: 140s; --delay: -95s" />
      <use href="#cloud" class="cloud" x="0" y="4" style="--t: 125s; --delay: -10s" />
    </g>

    <g clip-path="url(#sky)">
      <g class="sun-set">
        <circle class="sun-halo" cx="1090" cy="170" r="170" fill="url(#glow)" />
        <circle class="hero-sun" cx="1090" cy="170" r="96" fill="hsl(var(--accent))" />
      </g>
    </g>

    <g class="birds" fill="none" stroke="hsl(var(--bird))" stroke-width="2.2" stroke-linecap="round">
      <path class="bird" d="M0 40q7-8 14 0q7-8 14 0" />
      <path class="bird" d="M34 28q5-6 10 0q5-6 10 0" />
      <path class="bird" d="M22 58q6-7 12 0q6-7 12 0" />
    </g>

    <g fill="hsl(var(--field-4))">
      <path d="M0 170 Q40 150 80 162 Q120 146 170 160 Q210 150 250 166 L250 170Z" />
      <rect x="318" y="118" width="26" height="52" />
      <path d="M316 118h30v-6h-5v4h-5v-4h-5v4h-5v-4h-5v4h-5v-4z" />
      <path d="M520 170 Q560 156 600 164 Q660 150 720 166 L720 170Z" />
      <path d="M1300 170 Q1340 152 1380 160 Q1410 152 1440 158 L1440 170Z" />
    </g>
    <rect y="170" width="1440" height="16" fill="hsl(var(--field-1))" />
    <rect y="186" width="1440" height="24" fill="hsl(var(--field-2))" />
    <path d="M0 210h1440v36H0z" fill="hsl(var(--field-3))" />
    <rect class="glint" y="226" width="180" height="2" rx="1" fill="hsl(var(--accent))" opacity="0.7" />
    <path d="M0 246h1440v54H0z" fill="hsl(var(--ground))" />
    <path d="M0 186 L1440 200 L1440 210 L0 196Z" fill="hsl(var(--field-1))" opacity=".35" />
  </svg>
</section>
