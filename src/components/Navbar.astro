---
const links = [
  { href: "/#services", label: "Services" },
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/blog", label: "Blog" },
];
const linkClass =
  "rounded px-3 py-2 text-[0.95rem] font-medium text-muted-foreground transition-colors hover:text-foreground";
---

<header class="site-header sticky top-0 z-50 border-b border-transparent bg-background/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="text-lg font-extrabold tracking-tight">Peter Kaskonas</a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {links.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        aria-label="Dark theme"
        aria-pressed="false"
        class="grid h-10 w-10 place-items-center rounded text-muted-foreground transition-colors hover:text-foreground"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5" class="dark:hidden" />
          <path class="dark:hidden" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          <path class="hidden dark:block" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
      </button>
      <a href="/#contact" class="btn-primary hidden !py-2 text-sm sm:inline-flex">Start a project</a>
      <button
        type="button"
        popovertarget="site-menu"
        aria-label="Open menu"
        class="grid h-10 w-10 place-items-center rounded md:hidden"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h10" />
        </svg>
      </button>
    </div>
  </div>
</header>

<nav
  id="site-menu"
  popover
  aria-label="Mobile"
  class="site-menu m-0 ml-auto h-dvh w-[min(20rem,85vw)] overscroll-contain border-l bg-background p-6 pt-20 text-foreground"
>
  <ul class="space-y-1">
    {
      [...links, { href: "/#contact", label: "Contact" }].map((l) => (
        <li>
          <a href={l.href} class="block rounded px-2 py-3 text-2xl font-bold tracking-tight hover:text-primary">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .site-menu::backdrop {
    background: hsl(206 28% 8% / 0.5);
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-menu:popover-open {
      animation: slide-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .site-menu:popover-open li {
      animation: slide-in-item 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .site-menu li:nth-child(2) { animation-delay: 50ms; }
    .site-menu li:nth-child(3) { animation-delay: 100ms; }
    .site-menu li:nth-child(4) { animation-delay: 150ms; }
    .site-menu li:nth-child(5) { animation-delay: 200ms; }
  }
  @keyframes slide-in-item {
    from {
      opacity: 0;
      transform: translateX(2rem);
    }
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
</style>

<script>
  const root = document.documentElement;
  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
    btn.setAttribute("aria-pressed", String(root.classList.contains("dark")));
    btn.addEventListener("click", () => {
      const dark = root.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", dark ? "#0F1A24" : "#F3F7F8");
      btn.setAttribute("aria-pressed", String(dark));
    });
  });
  // Popover only light-dismisses; close it when a link inside is followed
  const menu = document.getElementById("site-menu");
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) menu.hidePopover();
  });
</script>
