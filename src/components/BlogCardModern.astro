---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { calculateReadingTime } from "@/lib/utils";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const date = new Date(post.data.date);
const formattedDate = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" }).format(date);
const readingTime = calculateReadingTime(post.body || "");
---

<article
  class:list={[
    "reveal group relative flex flex-col",
    featured && "md:grid md:grid-cols-[1.4fr_1fr] md:items-center md:gap-10",
  ]}
>
  <div class="overflow-hidden rounded-md">
    <Image
      src={post.data.coverImage}
      alt=""
      class:list={[
        "w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]",
        featured ? "aspect-[16/9]" : "aspect-[16/10]",
      ]}
      loading={featured ? "eager" : "lazy"}
      quality={80}
    />
  </div>
  <div class="mt-5 md:mt-0">
    <p class="text-sm text-muted-foreground">
      <time datetime={date.toISOString()}>{formattedDate}</time>, {readingTime}
    </p>
    <h2
      class:list={[
        "mt-2 font-bold leading-tight tracking-tight",
        featured ? "text-3xl md:text-4xl" : "text-xl",
      ]}
    >
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 group-hover:text-primary">
        {post.data.title}
      </a>
    </h2>
    <p class:list={["mt-3 text-muted-foreground", featured ? "line-clamp-4" : "line-clamp-2 text-base"]}>
      {post.data.excerpt}
    </p>
  </div>
</article>
