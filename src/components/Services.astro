---
interface Service {
  title: string;
  summary: string;
  includes: string[];
  stack: string[];
  note?: string;
}

const groups: { heading: string; intro: string; items: Service[] }[] = [
  {
    heading: "For local businesses",
    intro: "Trades, shops, restaurants and practices across Suffolk and East Anglia.",
    items: [
      {
        title: "Business websites",
        summary:
          "A fast site that gets you found on Google and makes it easy for customers to call, book or buy.",
        includes: [
          "Looks sharp on every phone, tablet and desktop",
          "Local SEO set up from day one",
          "Contact and booking forms",
          "Analytics so you can see where visitors come from",
          "Cheap, reliable hosting you can update yourself",
        ],
        stack: ["Astro", "React", "Tailwind CSS", "Cloudflare", "Google Analytics"],
      },
      {
        title: "Custom web apps and SaaS",
        summary:
          "Software that replaces spreadsheets, paper and copy-and-paste with something built around how you work.",
        includes: [
          "Booking and scheduling systems",
          "Customer portals for quotes, invoices and documents",
          "Online payments and subscriptions",
          "Dashboards that put your numbers in one place",
          "Full SaaS products, from first idea to paying customers",
        ],
        stack: ["Next.js", "TypeScript", "Stripe", "AWS", "PostgreSQL", "DynamoDB"],
      },
    ],
  },
  {
    heading: "For teams already on AWS",
    intro: "Engineering help from an AWS Certified Solutions Architect Professional.",
    items: [
      {
        title: "Serverless development",
        summary: "Cloud-native apps on pay-per-use infrastructure, deployed from code.",
        includes: [
          "AWS Lambda and serverless architecture",
          "Infrastructure as code with CDK and SST",
          "CI/CD pipelines for automated deploys",
          "Real-time data processing",
        ],
        stack: ["AWS Lambda", "SST", "CDK", "DynamoDB", "GitHub Actions"],
        note: "Recent projects saved 30–50% on cloud costs through architecture changes.",
      },
      {
        title: "Cloud cost reviews",
        summary: "An audit of your AWS account that cuts the bill without hurting performance.",
        includes: [
          "Find idle and over-provisioned resources",
          "Right-size to real usage and add auto-scaling",
          "Tune storage and data transfer",
          "Reserved instances and savings plans",
          "Monitoring and budget forecasting",
        ],
        stack: ["Cost Explorer", "CloudWatch", "Kubernetes", "Terraform", "Prometheus"],
        note: "Clients typically see a 30–60% drop in their monthly AWS bill.",
      },
    ],
  },
];
---

<section id="services" class="container-page py-24 lg:py-32">
  <h2 class="wipe max-w-2xl text-[clamp(2rem,4.5vw,3.25rem)] font-extrabold leading-[1.02]">What I build</h2>
  <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
    Most clients are local businesses who need a site that brings in work, or software that takes
    admin off their hands. I also help tech teams get more out of AWS.
  </p>

  <div class="mt-16 space-y-20">
    {
      groups.map((group) => (
        <div class="reveal grid gap-8 lg:grid-cols-[16rem_1fr] lg:gap-16">
          <div>
            <h3 class="text-xl font-bold">{group.heading}</h3>
            <p class="mt-2 text-muted-foreground">{group.intro}</p>
          </div>
          <ul class="border-t">
            {group.items.map((s) => (
              <li class="service-row reveal border-b py-8">
                <h4 class="text-2xl font-bold tracking-tight sm:text-3xl">{s.title}</h4>
                <p class="mt-3 max-w-[60ch] text-muted-foreground">{s.summary}</p>
                <details name={group.heading} class="group mt-5">
                  <summary class="inline-flex cursor-pointer list-none items-center gap-2 font-semibold text-primary [&::-webkit-details-marker]:hidden">
                    <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M8 2v12M2 8h12" />
                    </svg>
                    What's included
                  </summary>
                  <div class="mt-5 grid gap-6 sm:grid-cols-[1fr_auto]">
                    <ul class="list-disc space-y-1.5 pl-5 marker:text-accent">
                      {s.includes.map((i) => <li>{i}</li>)}
                    </ul>
                    <div class="text-sm text-muted-foreground sm:max-w-[16rem]">
                      <p class="font-semibold text-foreground">Built with</p>
                      <p class="mt-1" translate="no">{s.stack.join(", ")}</p>
                      {s.note && <p class="mt-4">{s.note}</p>}
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <p class="mt-16 text-lg">
    Not sure what you need?
    <a href="#contact" class="ink-link">
      Book a free, no-obligation chat.
    </a>
  </p>
</section>
